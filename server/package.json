{
  "name": "sun-studio",
  "productName": "Sun Studio",
  "version": "0.0.13",
  "private": false,
  "description": "Sun Studio \u2014 AI image studio for Windows (Next.js 16 + React 18 studio in an Electron shell). Bring your own key; nothing ships inside.",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3570",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3570",
    "serve": "node .next/standalone/server.js",
    "prepare:electron": "node scripts/prepare-electron.mjs",
    "dist": "npm run build && npm run prepare:electron && electron-builder --win nsis --x64 --publish never",
    "test:clients": "tsx scripts/test-clients.ts",
    "test:updater": "node scripts/test-updater.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "next": "16.2.6",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "electron": "^45.4.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
